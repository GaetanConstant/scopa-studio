# Copie ce fichier en .env et renseigne les valeurs pour la prod.
# Ne commite jamais .env — les secrets qui y vivent doivent rester locaux au serveur.

# Mot de passe commun d'accès à l'intranet
STUDIO_MOT_DE_PASSE=studio2026

# Clé de signature des jetons HMAC — SANS ELLE, CHAQUE REDÉMARRAGE DÉCONNECTE TOUT LE MONDE.
# Génère une clé sécurisée : python3 -c "import secrets; print(secrets.token_hex(32))"
STUDIO_SECRET=

# Chemin de la base SQLite (dans un volume Docker, typiquement /data/intranet.db)
# STUDIO_DB=/data/intranet.db

# Origines CORS autorisées (virgule-séparées).
# En prod : https://studio.scopa.co
STUDIO_ORIGINES=https://studio.scopa.co,http://localhost:5199,http://localhost:5173

# Préfixe de l'API derrière un proxy (ex. /studio-api si l'app parle à https://plouf.scopa.co/studio-api/)
STUDIO_ROOT_PATH=/studio-api
